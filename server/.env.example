# Copy to server/.env and adjust. All values are optional for local development.

# Port for the API (the React dev server proxies /api here).
PORT=4000

# Leave unset to use the built-in PGlite database stored in server/.data/pg.
# Set to a Postgres connection string in production, e.g. from Neon, Supabase or Render:
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Product photos are stored in the database. Photos saved to disk by older versions are still served from here
# (default: server/.data/uploads).
# UPLOAD_DIR=/var/data/uploads

# NODE_ENV=production

# Owners of Zed Market, comma-separated email addresses. They get the admin panel at /admin when they sign in with
# that address, once Clerk has verified it (on a development computer also before).
# ADMIN_EMAILS=owner@example.com

# Sign-in is run by Clerk (https://clerk.com, which has a free plan). Create an application with
# Email + Password and Google turned on, then copy the keys from Dashboard > API keys:
#  - CLERK_SECRET_KEY here (server only, never share it);
#  - REACT_APP_CLERK_PUBLISHABLE_KEY in .env.local at the project root (the website is built with it).
# CLERK_SECRET_KEY=sk_test_...

# Order alerts by email through Resend (https://resend.com, has a free plan). Without these nothing is emailed and
# alerts stay in the app. EMAIL_FROM must be an address on a domain verified in Resend. SITE_URL adds "open it" links.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Zed Market <noreply@yourdomain.com>
# SITE_URL=https://your-site.onrender.com

# Load demo shops and products into an empty database (off by default: shops are added by their owners).
# SEED_DEMO=1
