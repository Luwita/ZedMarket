{
  "name": "zed-market",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.9 <25"
  },
  "dependencies": {
    "@clerk/backend": "^2.33.8",
    "@clerk/clerk-js": "^5.128.1",
    "@electric-sql/pglite": "^0.5.8",
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4",
    "zod": "^4.6.5"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:server:dev\" \"npm:start\"",
    "start": "react-scripts start",
    "server": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=server/.env --env-file-if-exists=.env.local server/index.js",
    "server:dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=server/.env --env-file-if-exists=.env.local --watch server/index.js",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:server": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"server/**/*.test.js\"",
    "eject": "react-scripts eject",
    "reset:catalog": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=server/.env scripts/reset-catalog.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    }
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "proxy": "http://localhost:4000"
}
